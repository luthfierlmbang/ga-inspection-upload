# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=8787
# 0.0.0.0 kalau dijalankan di container atau di belakang reverse proxy lain host.
HOST=127.0.0.1

# Token GA Bot dari BotFather. Wajib untuk validasi initData Telegram.
BOT_TOKEN=

# ID Telegram dipisah koma. Satu ID boleh ada di keduanya (admin GA upload + review).
GA_UPLOADER_IDS=
GA_REVIEWER_IDS=

# URL publik HTTPS tempat Mini App ini disajikan, tanpa garis miring di akhir.
# Dipakai tombol web_app di notifikasi. Telegram menolak web_app dengan URL http.
PUBLIC_APP_URL=

# Notifikasi Telegram setelah upload / review. Default mati.
NOTIFY_ENABLED=0

# Mode dev: boleh pakai header X-Dev-User tanpa Telegram. Otomatis mati kalau NODE_ENV=production.
DEV_AUTH=0

# Opsional. Kunci tanda tangan URL foto. Kalau kosong diturunkan dari BOT_TOKEN.
PHOTO_URL_SECRET=

# Lokasi penyimpanan. Default: ./data/inspections.db dan ./uploads di root project.
# Di Docker arahkan ke volume, mis. DB_PATH=/data/inspections.db UPLOAD_DIR=/data/uploads
DB_PATH=
UPLOAD_DIR=
