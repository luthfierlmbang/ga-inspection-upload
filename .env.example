# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Token GA Bot dari BotFather. Wajib untuk validasi initData Telegram.
BOT_TOKEN=

# ID Telegram dipisah koma. Satu ID boleh ada di keduanya (admin GA upload + review).
GA_UPLOADER_IDS=
GA_REVIEWER_IDS=

# URL publik HTTPS tempat Mini App ini disajikan (dipakai tombol web_app di notifikasi).
PUBLIC_APP_URL=

# Notifikasi Telegram setelah upload / review. Default mati.
NOTIFY_ENABLED=0

# Mode dev: boleh pakai header X-Dev-User tanpa Telegram. Otomatis mati kalau NODE_ENV=production.
DEV_AUTH=0

# Opsional. Kunci tanda tangan URL foto. Kalau kosong diturunkan dari BOT_TOKEN.
PHOTO_URL_SECRET=

# Opsional. Lokasi data (default: ./data dan ./uploads di root project).
DATA_DIR=
UPLOAD_DIR=
